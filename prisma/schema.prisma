// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guest {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  email     String?
  category  String?  // VIP, Keluarga, Teman, Kolega
  createdAt DateTime @default(now())
  
  rsvp   Rsvp?
  wishes Wish[]
  
  @@index([slug])
}

model Rsvp {
  id         String   @id @default(cuid())
  guestId    String   @unique
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  
  attending  Boolean  // true = hadir, false = tidak hadir
  guestCount Int      @default(1) // jumlah tamu yang ikut
  message    String?  @db.Text // pesan tambahan
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Wish {
  id         String   @id @default(cuid())
  name       String   // nama pengirim ucapan
  message    String   @db.Text // ucapan & doa
  
  guestId    String?
  guest      Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  
  createdAt  DateTime @default(now())
  isApproved Boolean  @default(true) // untuk moderasi (opsional)
  
  @@index([createdAt(sort: Desc)])
}
